{
  "name": "ottodot-trial-booking",
  "version": "0.1.0",
  "private": true,
  "description": "Ottodot take-home: a small, correct trial-class booking slice (4-seat cap, payment, last-seat race).",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prestart": "node scripts/check-node.mjs",
    "start": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/server.ts",
    "dev": "node --watch --experimental-strip-types --no-warnings=ExperimentalWarning src/server.ts",
    "preseed": "node scripts/check-node.mjs",
    "seed": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/seed.ts --reset",
    "pretest": "node scripts/check-node.mjs",
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning \"test/**/*.test.ts\"",
    "demo:race": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/demo-race.ts",
    "typecheck": "tsc --noEmit",
    "check-node": "node scripts/check-node.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
